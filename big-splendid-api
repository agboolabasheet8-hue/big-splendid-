model User {
  id String @id @default(cuid())
  email String @unique
  isVerified Boolean @default(false)
  listings Listing[]
}

model Listing {
  id String @id @default(cuid())
  title String
  platform String
  price Int
  status String @default("PENDING")
  seller User @relation(fields: [sellerId], references: [id])
  sellerId String
}
